# Copy to .env. Keep real credentials server-side.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL_ID=darkc0de/XORTRON-RICO-v3
XORTRON_AGENT_MODEL_ID=darkc0de/XORTRON-AgentRICO
EXA_API_KEY=
# Set to your own SearXNG URL or a trusted instance with JSON output enabled.
SEARXNG_URL=
# SQLite locally; use Supabase/Postgres for hosted persistent storage.
DATABASE_URL=sqlite:///./fieldwork.db
# Required before public deployment. Leave empty only for local development.
APP_PASSWORD=
APP_NAME=FIELDWORK
REQUEST_TIMEOUT_SECONDS=28
