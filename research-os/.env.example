# Copy to .env and fill in what you have. Every provider is optional:
# set FEATHERLESS_API_KEY and at least one search provider (SearXNG runs in Docker and needs no key).
ADMIN_TOKEN=pick-a-long-random-string        # your login token for the web UI and API
ADMIN_EMAIL=you@example.com
POSTGRES_PASSWORD=change-me
SEARXNG_SECRET=change-me-too

# Models (routes.yaml decides which model does which task)
FEATHERLESS_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_MODEL=openai:text-embedding-3-small   # optional; keyword search is used when empty

# Search / fetch providers
DEFAULT_SEARCH_PROVIDERS=exa,searxng
EXA_API_KEY=
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# FIRECRAWL_API_KEY=
# APIFY_TOKEN=
# APIFY_SEARCH_ACTOR=apify~rag-web-browser
# APIFY_FETCH_ACTOR=apify~rag-web-browser
# PERPLEXITY_API_KEY=
# JINA_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# OPENALEX_MAILTO=you@example.com

# Where the browser reaches the services (change when deploying to a server)
# PUBLIC_WEB_URL=http://localhost:3000
# PUBLIC_API_URL=http://localhost:8000/api
