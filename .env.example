# Copy to .env (never commit .env) or set these in your host's dashboard.
FEATHERLESS_API_KEY=your-featherless-key   # optional: can also be set in the app's Settings
APP_PASSWORD=pick-a-long-password          # REQUIRED if the app is reachable from the internet
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# DATA_DIR=./data
# COOKIE_SECURE=1                          # set when served over HTTPS
# MAX_UPLOAD_MB=50
